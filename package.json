{
  "name": "house",
  "version": "1.0.0",
  "description": "House – Real-time multi-user virtual workspace",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:hybrid": "concurrently \"RUNTIME_MODE=hybrid npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"npm run dev:rust\"",
    "start:backend": "npm start --prefix backend",
    "start:backend:node": "RUNTIME_MODE=node npm start --prefix backend",
    "start:backend:hybrid": "RUNTIME_MODE=hybrid npm start --prefix backend",
    "start:backend:rust": "RUNTIME_MODE=rust npm start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:rust": "cargo run --manifest-path realtime-rs/Cargo.toml",
    "start:rust": "cargo run --release --manifest-path realtime-rs/Cargo.toml",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
